[node name="SlideManager" parent="." unique_id=1977986039 instance=ExtResource("4_kyai0")]
slide_description = "Oh no! In a totally not scripted and pre-planned event, the jump module has broken, and you have to replace it!

Implement a new jump system to complete this level.
The CatCode editor has a help button and list of instructions to assist you, and there are hints in the top right too.

Jumping in the air causes an error to occur. Try to design your script to make jumping when not grounded impossible to prevent this."
slide_hint1 = "If you are struggling try to break down the decisions CatBot must make every frame."
slide_hint2 = "Every frame the cat must make a decision whether it should execute the jump function. The script you are screating will execute every frame, therefore an if statement will be required."
slide_hint3 = "The and statement returns true when both of its operands are also true. For the jump to be valid there must be two conditions to be met.

You can also create the same behaviour by putting an if inside another if."
slide_solution = "To do a simple jump script use the script:

if(isButtonJustPressed(Z)):
	jump()

For the more complex system that doesnt produce errors if you jump in midair you use the function isGround() either in the if block:
if (isGrounded and isButtonJustPressed()):
	jump()

or by nesting a second if statement into the first:
if(isButtonJustPressed()):
	if(isGrounded()):
		jump()"

