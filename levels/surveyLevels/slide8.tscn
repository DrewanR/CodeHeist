[node name="SlideManager" parent="." unique_id=1977986039 instance=ExtResource("4_0ti3c")]
slide_description = "It appears you may need to do some more programming, remember what you did on the last slide and expand on it clear the larger gaps.

Bonus points if you manage to program something that cannot throw an error if you air swipe too many times or jump in mid air.

If you you want even more bonus points (although no one is counting) if you are able to do using only a single button."
slide_hint1 = "The swipe function causes catBot to swipe.

The jump function causes catBot to jump.

However, these are two scenarios so will need to be handelled seperately."
slide_hint2 = "You are able to chain multiple if statements in the same script without them interacting.

For example:
if(true):
	print(meow)
if(true):
	print(purr)

Will output:
	meow
	purr
"
slide_hint3 = "If you are trying to do it with a single button, consider the scenarios in which you will want to jump and air swipe.

Are they the same?"
slide_solution = "There are numerous ways of doing this, I will list the one I would do:

If you do not care about producing errors:
if(isButtonJustPressed(z)):
	jump()
if(isButtonJustPressed(X)):
	swipe()

If you want to prevent errors:
if(isButtonJustPressed(z) and isGrounded()):
	jump()
if(isButtonJustPressed(X) and canSwipe()):
	swipe()

And, if you feel fancy and want to use a single button:
if(isButtonJustPressed(Z)):
	if(isGrounded()):
		jump()
	else if(canStrike()):
		swipe()
"

